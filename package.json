{
  "name": "khazri-dmc",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "start": "node dist-server/index.js",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false",
    "db:init": "tsx server/db/init.ts",
    "leads:export": "tsx server/cli/export-leads.ts"
  },
  "dependencies": {
    "better-sqlite3": "12.4.1",
    "express": "5.1.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.1.0",
    "nodemailer": "10.1.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/express": "5.0.5",
    "@types/node": "24.10.0",
    "@types/nodemailer": "7.0.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.0",
    "concurrently": "9.2.1",
    "supertest": "7.1.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.2.2",
    "vitest": "4.0.9"
  }
}
